<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.kinalquickmart.system.controller.PagoDialogController"
            style="-fx-background-color: #ecf0f1;">
    
    <top>
        <Label text="FINALIZAR VENTA" 
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a5276;"
               BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>
        </Label>
    </top>
    
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <!-- NIT/CF -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="NIT/CF:" 
                       style="-fx-font-weight: bold;"
                       prefWidth="120"/>
                <TextField fx:id="txtNit" 
                           promptText="Opcional - Ingrese NIT o CF"
                           HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Forma de Pago -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Forma de Pago:" 
                       style="-fx-font-weight: bold;"
                       prefWidth="120"/>
                <ComboBox fx:id="cmbFormaPago" 
                          HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Monto Recibido -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Monto Recibido:" 
                       style="-fx-font-weight: bold;"
                       prefWidth="120"/>
                <TextField fx:id="txtMontoRecibido" 
                           promptText="Ingrese el monto que da el cliente"
                           HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Cambio -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Cambio:" 
                       style="-fx-font-weight: bold;"
                       prefWidth="120"/>
                <Label fx:id="lblCambio" 
                       text="Q0.00"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"
                       HBox.hgrow="ALWAYS"/>
            </HBox>
            
        </VBox>
    </center>
    
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            
            <Button fx:id="btnConfirmar" 
                    text="CONFIRMAR PAGO"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"/>
            
            <Button fx:id="btnCancelar" 
                    text="CANCELAR"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"/>
        </HBox>
    </bottom>
    
</BorderPane>