<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalquickmart.system.controller.EditProductController" style="-fx-padding: 20; -fx-background-color: #f4f4f4;">
    
    <Label text="Editar Producto" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    
    <GridPane hgap="10" vgap="10">
        <Label text="Nombre Comercial:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="txtNombreComercial" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" />
        
        <Label text="Precio Costo ($):" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <TextField fx:id="txtPrecioCosto" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        
        <Label text="Precio Venta ($):" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="txtPrecioVenta" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        
        <Label text="Stock Actual:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextField fx:id="txtStock" GridPane.rowIndex="3" GridPane.columnIndex="1" />
        
        <Label text="Categoría:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
        <TextField fx:id="txtCategoria" GridPane.rowIndex="4" GridPane.columnIndex="1" editable="false" style="-fx-background-color: #ecf0f1;" />
    </GridPane>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" />
        <Button fx:id="btnGuardar" text="Guardar Cambios" onAction="#guardarCambios" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;" />
    </HBox>
</VBox>